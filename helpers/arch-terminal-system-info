#!/bin/sh
# Generate the small QML data object consumed by Arch Terminal at greeter
# startup. This helper is run by systemd as root before SDDM starts.

set -eu

runtime_dir=/run/sddm/arch-terminal
target_file=$runtime_dir/SystemInfo.qml

read_os_release_value() {
    requested_key=$1

    if [ ! -r /etc/os-release ]; then
        return 0
    fi

    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$requested_key"=*)
                printf '%s' "${line#*=}"
                return 0
                ;;
        esac
    done < /etc/os-release
}

strip_os_release_quotes() {
    value=$1

    case "$value" in
        \"*\")
            value=${value#\"}
            value=${value%\"}
            ;;
        \'*\')
            value=${value#\'}
            value=${value%\'}
            ;;
    esac

    printf '%s' "$value"
}

# Quote data for a QML string literal. Values are treated solely as data: the
# helper does not source os-release or evaluate anything that it contains.
qml_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/[[:cntrl:]]//g'
}

distribution_name=$(read_os_release_value PRETTY_NAME || true)
if [ -z "$distribution_name" ]; then
    distribution_name=$(read_os_release_value NAME || true)
fi
if [ -z "$distribution_name" ]; then
    distribution_name=Linux
fi
distribution_name=$(strip_os_release_quotes "$distribution_name")

# /usr/bin/uname -r is executed directly with no user-controlled arguments.
kernel_release=$(/usr/bin/uname -r)

install -d -o root -g root -m 0755 "$runtime_dir"
temporary_file=$(mktemp "$runtime_dir/.SystemInfo.qml.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM

{
    printf '%s\n' '// Generated by arch-terminal-system-info; do not edit.'
    printf '%s\n' 'import QtQml'
    printf '%s\n' 'QtObject {'
    printf '    readonly property string distributionName: "%s"\n' \
        "$(qml_escape "$distribution_name")"
    printf '    readonly property string kernelRelease: "%s"\n' \
        "$(qml_escape "$kernel_release")"
    printf '%s\n' '}'
} > "$temporary_file"

chown root:root "$temporary_file"
chmod 0644 "$temporary_file"
mv -f "$temporary_file" "$target_file"
trap - EXIT HUP INT TERM
